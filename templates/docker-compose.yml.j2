---
services:
  server:
    container_name: '{{ attic_cont_name }}'
    image: '{{ attic_cont_image }}'
    restart: always
    command: ['-f', '{{ attic_config_cont_file }}']
    ports:
      - '127.0.0.1:{{ attic_cont_port }}:{{ attic_cont_port }}'
    volumes:
      - '{{ attic_config_dir }}:{{ attic_config_cont_dir }}:ro'
    networks:
      - '{{ attic_network_name }}'
    healthcheck:
      test: ["CMD-SHELL", "wget -q -O /dev/null http://localhost:{{ attic_cont_port }}/ || exit 1"]
      interval: 30s
      timeout: 10s
      retries: 3

networks:
  {{ attic_network_name }}:
    external: true
